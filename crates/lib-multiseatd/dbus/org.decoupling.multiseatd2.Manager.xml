<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/decoupling/multiseatd2">
  <interface name="org.decoupling.multiseatd2.Manager">
    <method name="CreateContext">
      <arg name="seat" type="s" direction="in"/>
      <arg name="authority" type="h" direction="out"/>
      <arg name="context_id" type="s" direction="out"/>
    </method>
    <method name="ActivateContext"><arg name="authority" type="h" direction="in"/></method>
    <method name="DeactivateContext"><arg name="authority" type="h" direction="in"/></method>
    <method name="RemoveContext"><arg name="authority" type="h" direction="in"/></method>
    <method name="GrantAccess">
      <arg name="authority" type="h" direction="in"/><arg name="uid" type="u" direction="in"/>
    </method>
    <method name="RevokeAccess">
      <arg name="authority" type="h" direction="in"/><arg name="uid" type="u" direction="in"/>
    </method>
    <method name="CreateConnection">
      <arg name="authority" type="h" direction="in"/>
      <arg name="connection" type="h" direction="out"/><arg name="connection_id" type="s" direction="out"/>
    </method>
    <method name="RemoveConnection">
      <arg name="authority" type="h" direction="in"/><arg name="connection_id" type="s" direction="in"/>
    </method>
    <method name="GetSeatMetadata">
      <arg name="authority" type="h" direction="in"/>
      <arg name="seat" type="s" direction="out"/><arg name="graphical_vt" type="u" direction="out"/>
    </method>
    <method name="GetContext">
      <arg name="authority" type="h" direction="in"/><arg name="context" type="(sssauasbbs)" direction="out"/>
    </method>
    <method name="ActivateContextById"><arg name="context_id" type="s" direction="in"/></method>
    <method name="DeactivateContextById"><arg name="context_id" type="s" direction="in"/></method>
    <method name="RemoveContextById"><arg name="context_id" type="s" direction="in"/></method>
    <method name="RemoveConnectionById"><arg name="connection_id" type="s" direction="in"/></method>
    <method name="ListSeats"><arg name="seats" type="a(subssss)" direction="out"/></method>
    <method name="ListContexts"><arg name="contexts" type="a(sssauasbbs)" direction="out"/></method>
    <method name="ListConnections"><arg name="connections" type="a(sssss)" direction="out"/></method>
    <signal name="StateChanged"><arg name="revision" type="t"/></signal>
  </interface>
  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect"><arg name="xml" type="s" direction="out"/></method>
  </interface>
  <interface name="org.freedesktop.DBus.Peer"><method name="Ping"/></interface>
</node>
